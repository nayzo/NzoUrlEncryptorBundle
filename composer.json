{
    "name": "nzo/url-encryptor-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle to encrypt and decrypt the data passed through the URL, or any other value, with authenticated encryption",
    "keywords": [
        "url",
        "link",
        "encryption",
        "decryption",
        "encrypt",
        "decrypt",
        "id",
        "data",
        "security",
        "AES",
        "HMAC",
        "authenticated encryption",
        "key rotation"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ala Eddine Khefifi",
            "email": "alakfpro@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Nzo\\UrlEncryptorBundle\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "twig/twig": "Required for the nzo_encrypt and nzo_decrypt filters and functions"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpunit/phpunit": "^9.6",
        "rector/rector": "^1.2 || ^2.0",
        "symfony/var-dumper": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "7.0-dev"
        }
    }
}
