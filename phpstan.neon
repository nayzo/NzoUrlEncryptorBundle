parameters:
    level: max
    # The types written in a doc block are what a caller should pass, not what it does pass
    treatPhpDocTypesAsCertain: false
    paths:
        - .
    excludePaths:
        - vendor/*
        - Tests/*
    # Symfony 8.2 classes, missing when the analysis runs on an older version
    ignoreErrors:
        -
            message: '#Symfony\\Component\\HttpKernel\\(Event\\ControllerAttributeEvent|Attribute\\RecoverableAttribute)#'
            reportUnmatched: false
